{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lickgrass/upload-doctor/raw/main/schemas/contract.schema.json",
  "title": "Upload Doctor contract v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9_-]{1,64}$"
    },
    "storageHosts": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 253,
        "pattern": "^[^\\s/@?#]+$"
      },
      "maxItems": 32,
      "minItems": 1,
      "uniqueItems": true
    },
    "provider": {
      "enum": ["s3", "r2"]
    },
    "method": {
      "const": "PUT"
    },
    "body": {
      "enum": ["raw", "any"]
    },
    "contentType": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9!#$&^_.+-]+/[a-zA-Z0-9!#$&^_.+-]+(?:;[\\x20-\\x7e]*)?$"
    },
    "requiredResponseHeaders": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9!#$%&'*+.^_`|~-]{1,128}$"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "pathStyle": {
      "type": "boolean"
    }
  },
  "required": ["version", "id", "storageHosts"]
}
